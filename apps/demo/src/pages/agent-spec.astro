---
import SiteLayout from "../site/layouts/site-layout.astro";
import { CopyButton } from "../site/components/copy-button";
import { agentSpec as source } from "@snackbit/opendil/agent-spec";
import "../site/styles/code-sample.css";
---

<SiteLayout
  title="Agent Spec | OpenDIL"
  description="Copy the OpenDIL generation instructions for your agent."
>
  <section class="od-container od-section">
    <h1>Agent Spec</h1>
    <div class="od-code-sample">
      <div class="od-code-sample-header">
        <span>genui.agent.md</span>
        <CopyButton text={source} label="Copy spec" client:load />
      </div>
      <pre class="agent-source"><code>{source}</code></pre>
    </div>
  </section>
</SiteLayout>

<style>
  .agent-source {
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
</style>
