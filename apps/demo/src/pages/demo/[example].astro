---
import Layout from "../../site/layouts/site-layout.astro";
import { Workbench } from "../../workbench/workbench";
import { examples, exampleById } from "../../examples/catalog";
import "../../site/styles/workbench.css";
export function getStaticPaths() {
  return examples.map((example) => ({ params: { example: example.id } }));
}
const example = exampleById(Astro.params.example ?? "deployment");
---

<Layout
  title={`${example.title} · OpenDIL demo`}
  description={example.description}
  workspace
>
  <Workbench initialId={example.id} client:only="react">
    <div slot="fallback" class="od-container od-workspace-heading">
      <h1>{example.title}</h1>
      <p>{example.description}</p>
      <p>Loading the interactive workbench…</p>
    </div>
  </Workbench>
</Layout>
