---
import { Code } from "astro:components";
import "../styles/code-sample.css";
import { CopyButton } from "./copy-button";
interface Props {
  code: string;
  language?: "tsx" | "bash" | "css" | "mdx";
  label?: string;
}
const { code, language = "tsx", label = language } = Astro.props;
---

<div class="od-code-sample">
  <div class="od-code-sample-header">
    <span>{label}</span>
    <CopyButton text={code} client:load />
  </div>
  <Code
    code={code}
    lang={language}
    themes={{ light: "github-light", dark: "github-dark" }}
  />
</div>
