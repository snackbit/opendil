---
import "@fontsource-variable/space-grotesk";
import "@fontsource-variable/inter";
import "@fontsource/ibm-plex-mono/400.css";
import "@fontsource/ibm-plex-mono/500.css";
import "@snackbit/opendil/styles.css";
import "../../demo.css";
import "../styles/tokens.css";
import "../styles/site.css";
import "../styles/editor.css";
import Header from "../components/site-header.astro";
import Brand from "../components/brand.astro";
import ThemeProvider from "../components/theme-provider.astro";
import { getImage } from "astro:assets";
import socialSource from "../assets/charts.png";
import { sitePath, repository } from "../links";
interface Props {
  title: string;
  description: string;
  workspace?: boolean;
}
const { title, description, workspace = false } = Astro.props;
const social = await getImage({ src: socialSource, format: "png" });
const socialImage = new URL(social.src, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content={String(social.attributes.width)} />
    <meta
      property="og:image:height"
      content={String(social.attributes.height)}
    />
    <meta property="og:image:alt" content="Charts rendered by OpenDIL" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="canonical" href={Astro.url} />
    <link rel="icon" href={sitePath("favicon.svg")} type="image/svg+xml" />
    <title>{title}</title>
    <ThemeProvider />
  </head>
  <body class:list={["od-page", { "od-workspace-page": workspace }]}>
    <a class="od-skip" href="#main">
      Skip to content
    </a>
    <header class="od-site-header">
      <Header />
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="od-footer od-container">
      <Brand />
      <span>Open source. Built for your application.</span>
      <nav aria-label="Footer">
        <a href={sitePath("docs/getting-started/")}>Documentation</a>
        <a href={repository}>GitHub</a>
        <a href={repository + "/blob/main/LICENSE"}>Apache 2.0</a>
        <a href={repository + "/releases"}>Releases</a>
      </nav>
      <p class="od-footer-credit">
        Made by <a href="https://turtledev.net">Felix Faust</a>. Open to
        freelance projects, which help fund OpenDIL.
      </p>
    </footer>
  </body>
</html>
