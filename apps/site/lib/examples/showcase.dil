# Interactive workspace

Analytics, pricing, forms, and diagrams in one streamed document.
The controls are live; all data is local to this example.

{@body const [period, setPeriod] = DIL.useState("6m")}
{@body const [metric, setMetric] = DIL.useState("revenue")}
{@body const [growth, setGrowth] = DIL.useState(18)}
{@body const [base, setBase] = DIL.useState(125)}
{@body const [showTarget, setShowTarget] = DIL.useState(true)}
{@body const labels =
  period === "3m"
    ? ["Aug", "Sep", "Oct"]
    : period === "6m"
      ? ["May", "Jun", "Jul", "Aug", "Sep", "Oct"]
      : [
          "Nov",
          "Dec",
          "Jan",
          "Feb",
          "Mar",
          "Apr",
          "May",
          "Jun",
          "Jul",
          "Aug",
          "Sep",
          "Oct",
        ]}
{@body const series = labels.map((m, i) => ({
  month: m,
  revenue: Math.round(base * Math.pow(1 + growth / 100 / 12, i)),
  users: Math.round(3200 * Math.pow(1 + growth / 100 / 12, i)),
  target: Math.round(base * Math.pow(1 + 0.12 / 12, i)),
}))}
{@body const last = series[series.length - 1]}
{@body const growthFactor = Math.pow(
  1 + growth / 100 / 12,
  labels.length - 1,
)}
{@body const euro = (n) =>
  new Intl.NumberFormat("en-US", {
    maximumFractionDigits: 0,
  }).format(n)}
{@body const [showBreakdown, setShowBreakdown] = DIL.useState(false)}
{@body const [billing, setBilling] = DIL.useState("annual")}
{@body const [seats, setSeats] = DIL.useState(8)}
{@body const [tier, setTier] = DIL.useState("pro")}
{@body const [addon, setAddon] = DIL.useState(true)}
{@body const tierPrice = tier === "starter" ? 12 : tier === "pro" ? 29 : 69}
{@body const monthlyPrice =
  (tierPrice * seats + (addon ? 35 : 0)) *
  (billing === "annual" ? 0.8 : 1)}
{@body const [name, setName] = DIL.useState("Alex")}
{@body const [theme, setTheme] = DIL.useState("indigo")}
{@body const [radius, setRadius] = DIL.useState(16)}
{@body const [density, setDensity] = DIL.useState("comfortable")}
{@body const [tasks, setTasks] = DIL.useState([true, false, true, false])}
{@body const taskNames = [
  "Design system approved",
  "Analytics integration complete",
  "Accessibility review",
  "Production rollout",
]}
{@body const completed = tasks.filter(Boolean).length}
{@body const [notice, setNotice] = DIL.useState("")}

## Analytics

<box border radius="2xl" padding={4} gap={4}>
  <row align="center" justify="between" wrap="wrap">
    <row align="center" gap={2}>
      <box background="surface-secondary" radius="lg" padding={2}>
        <icon name="chart-no-axes-combined" size="lg" />
      </box>
      <box gap={0}>
        **Acme Analytics**
        <caption>Workspace metrics</caption>
      </box>
    </row>
    <badge color="success">
      <icon name="circle-check" size="xs" inline />
      Operational
    </badge>
  </row>
  <divider color="subtle" />
  <row justify="between" align="center" wrap="wrap">
    <title size="lg">Performance overview</title>
    <segmented-control
      size="md"
      value={period}
      onChange={setPeriod}
      options={[
        { label: "3M", value: "3m" },
        { label: "6M", value: "6m" },
        { label: "12M", value: "12m" },
      ]}
    />
  </row>
  <grid columns={2} gap={2}>
    <grid-item>
      <box
        background="surface-secondary"
        padding={3}
        radius="lg"
        gap={2}
      >
        <row justify="between" align="center">
          <caption>Monthly revenue</caption>
          <icon name="wallet" color="secondary" />
        </row>
        <title size="xl" color="default" tabularNums>€{euro(last.revenue * 1000)}</title>
        <text color="success" size="xs">
          <icon name="trending-up" inline size="xs" />
          +{(100 * (growthFactor - 1)).toFixed(1)}% over period
        </text>
      </box>
    </grid-item>
    <grid-item>
      <box
        background="surface-secondary"
        padding={3}
        radius="lg"
        gap={2}
      >
        <row justify="between" align="center">
          <caption>Active users</caption>
          <icon name="users" color="secondary" />
        </row>
        <title size="xl" tabularNums>{euro(last.users)}</title>
        <text color="success" size="xs">
          <icon name="trending-up" inline size="xs" />
          +{growth}% annualized
        </text>
      </box>
    </grid-item>
    <grid-item>
      <box border radius="lg" padding={3} gap={1}>
        <caption>Conversion rate</caption>
        <title size="xl" tabularNums>{(3.4 + growth / 100).toFixed(2)}%</title>
      </box>
    </grid-item>
    <grid-item>
      <box border radius="lg" padding={3} gap={1}>
        <caption>Customer satisfaction</caption>
        <title size="xl">98.2%</title>
      </box>
    </grid-item>
  </grid>
  <row align="center" justify="between" wrap="wrap">
    **Performance trend**
    <segmented-control
      size="sm"
      value={metric}
      onChange={setMetric}
      options={[
        { label: "Revenue", value: "revenue" },
        { label: "Users", value: "users" },
      ]}
    />
  </row>
  <Chart content={{
    chartType: "line",
    meta: { footer: "Generated synthetic series" },
    xKey: "month",
    series:
      metric === "revenue"
        ? [
            { dataKey: "revenue", label: "Revenue (€k)" },
            ...(showTarget
              ? [{ dataKey: "target", label: "Target (€k)" }]
              : []),
          ]
        : [{ dataKey: "users", label: "Active users" }],
    data: series,
  }} />
  <checkbox
    checked={showTarget}
    onChange={setShowTarget}
    disabled={metric !== "revenue"}
    lineThrough={false}
  >
    Show revenue target
  </checkbox>
  <divider color="subtle" />
  <row justify="between" align="center">
    **Annual growth assumption**
    <title size="lg" tabularNums>{growth}%</title>
  </row>
  <slider
    min={-20}
    max={60}
    step={2}
    value={growth}
    onChange={setGrowth}
    marks={[
      { value: -20, label: "-20%" },
      { value: 0, label: "0%" },
      { value: 20, label: "20%" },
      { value: 40, label: "40%" },
      { value: 60, label: "60%" },
    ]}
  />
  <row justify="between" align="center">
    **Starting revenue (€k)**
    <title size="lg" tabularNums>€{base}k</title>
  </row>
  <slider
    min={50}
    max={300}
    step={5}
    value={base}
    onChange={setBase}
  />
  <row justify="end" align="center">
    <button
      size="md"
      color="secondary"
      variant="outline"
      onClick={() => {
        setGrowth(18);
        setBase(125);
        setPeriod("6m");
        setMetric("revenue");
        setShowTarget(true);
      }}
    >
      <icon name="rotate-ccw" inline />
      Reset
    </button>
  </row>
  <checkbox checked={showBreakdown} onChange={setShowBreakdown} lineThrough={false}>
    Show monthly breakdown
  </checkbox>
  {#if showBreakdown}
    <table>
      <table-row>
        <table-cell>Month</table-cell>
        <table-cell>Revenue</table-cell>
        <table-cell>Active users</table-cell>
      </table-row>
      {#each series as month}
        <table-row>
          <table-cell>{month.month}</table-cell>
          <table-cell>€{euro(month.revenue * 1000)}</table-cell>
          <table-cell>{euro(month.users)}</table-cell>
        </table-row>
      {/each}
    </table>
  {/if}
</box>

## Workspace pricing

<box border radius="2xl" padding={4} gap={3}>
  <row justify="between" align="center" wrap="wrap">
    <box gap={1}>
      <title size="lg">Configure your workspace</title>
      <caption>Choose a plan and billing period</caption>
    </box>
    <segmented-control
      size="md"
      value={billing}
      onChange={setBilling}
      options={[
        { label: "Monthly", value: "monthly" },
        { label: "Annual", value: "annual" },
      ]}
    />
  </row>
  <grid columns={3} gap={2}>
    {#each [
      { id: "starter", name: "Starter", price: 12 },
      { id: "pro", name: "Pro", price: 29 },
      { id: "enterprise", name: "Scale", price: 69 },
    ] as plan}
    <grid-item key={plan.id}>
      <pressable
        onClick={() => setTier(plan.id)}
        background={tier === plan.id ? "surface-secondary" : undefined}
        border={{
          size: tier === plan.id ? 2 : 1,
          color: tier === plan.id ? "strong" : "subtle",
        }}
        radius="xl"
        padding={3}
        gap={2}
      >
        <row justify="between" align="center">
          <text weight="medium" size="sm">{plan.name}</text>
          {#if tier === plan.id}
          <icon name="circle-check" color="default" />
          {:else}
          <icon name="circle" color="tertiary" />
          {/if}
        </row>
        <title size="xl" tabularNums>€{plan.price}</title>
        <caption>seat / month</caption>
      </pressable>
    </grid-item>
    {/each}
  </grid>
  <row align="center" justify="between">
    **Team members**
    <title size="lg" tabularNums>{seats}</title>
  </row>
  <slider
    value={seats}
    onChange={setSeats}
    min={1}
    max={50}
    step={1}
  />
  <checkbox
    checked={addon}
    onChange={setAddon}
    lineThrough={false}
  >
    Advanced analytics add-on (+€35/month)
  </checkbox>
  <box
    background="surface-secondary"
    radius="xl"
    padding={4}
    gap={3}
  >
    <row justify="between" align="center">
      <box gap={1}>
        <caption>Estimated monthly cost</caption>
        <title size="2xl" tabularNums>€{monthlyPrice.toFixed(2)}</title>
      </box>
      <badge color={billing === "annual" ? "success" : "secondary"}>{billing === "annual" ? "20% discount" : "Standard price"}</badge>
    </row>
    <divider />
    <row justify="between">
      <text color="secondary" size="sm">
        {seats} seats × €{tierPrice}
      </text>
      <text size="sm" tabularNums>€{(seats * tierPrice).toFixed(2)}</text>
    </row>
    <row justify="between">
      <text color="secondary" size="sm">Analytics add-on</text>
      <text size="sm" tabularNums>€{addon ? 35 : 0}</text>
    </row>
    {#if billing === "annual"}
    <row justify="between">
      <text color="success" size="sm">Annual discount</text>
      <text color="success" size="sm" tabularNums>−€{((seats * tierPrice + (addon ? 35 : 0)) * 0.2).toFixed(2)}</text>
    </row>
    {/if}
    <divider />
    <row justify="between">**Annualized cost** **€{euro(monthlyPrice * 12)}**</row>
  </box>
  <button block onClick={() =>
    GenUI.copy(
      `Plan: ${tier}\nSeats: ${seats}\nBilling: ${billing}\nAnalytics: ${addon}\nMonthly: €${monthlyPrice.toFixed(2)}\nAnnual: €${(monthlyPrice * 12).toFixed(2)}`,
    )}>
    <icon name="copy" inline />
    Copy configuration
  </button>
</box>

## Charts

<box gap={3}>
  <box border radius="xl" padding={3} gap={1}>
    **Categorical bar chart**
    <caption>Deployments by region</caption>
    <Chart content={{
      chartType: "bar",
      xKey: "region",
      series: [
        { dataKey: "successful", label: "Successful" },
        { dataKey: "failed", label: "Failed" },
