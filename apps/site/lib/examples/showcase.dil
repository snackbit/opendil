  <box border radius="xl" padding={3} gap={1}>
    **Proportional donut/pie chart**
    <caption>Traffic by source</caption>
    <Chart content={{
      chartType: "pie",
      nameKey: "source",
      valueKey: "share",
      series: [{ dataKey: "share", label: "Share" }],
      data: [
        { source: "Organic", share: 45 },
        { source: "Direct", share: 28 },
        { source: "Referral", share: 17 },
        { source: "Social", share: 10 },
      ],
    }} />
  </box>
  <box border radius="xl" padding={3} gap={1}>
    **Scatter plot**
    <caption>
      Latency and throughput
    </caption>
    <Chart content={{
      chartType: "scatter",
      xKey: "latency",
      xAxisLabel: "Latency (ms)",
      series: [{ dataKey: "throughput", label: "Requests/s" }],
      data: [
        { latency: 25, throughput: 920 },
        { latency: 32, throughput: 870 },
        { latency: 40, throughput: 950 },
        { latency: 53, throughput: 740 },
        { latency: 61, throughput: 800 },
        { latency: 75, throughput: 650 },
        { latency: 95, throughput: 530 },
        { latency: 115, throughput: 420 },
      ],
    }} />
  </box>
</box>

## Service topology

{@body const nodes = [
  { label: "Gateway", sub: "Ingress", x: 18, y: 105 },
  { label: "API Service", sub: "Compute", x: 182, y: 40 },
  { label: "Worker", sub: "Async jobs", x: 182, y: 170 },
  { label: "Database", sub: "Storage", x: 350, y: 40 },
  { label: "Queue", sub: "Messaging", x: 350, y: 170 },
]}
{@body const [node, setNode] = DIL.useState(1)}
<box border radius="2xl" padding={3} gap={3}>
  <row align="center" justify="between">
    **Service architecture**
    <badge color="success">5 healthy nodes</badge>
  </row>
  <svg viewBox="0 0 480 258" width="100%" xmlns="http://www.w3.org/2000/svg">
    <defs>
      <marker
        id="arrow-ui-demo"
        markerWidth="7"
        markerHeight="7"
        refX="6"
        refY="3.5"
        orient="auto"
      >
        <path d="M0 0 L7 3.5 L0 7 Z" fill="#8b8e9d" />
      </marker>
    </defs>
    {#each [
      [0, 1],
      [0, 2],
      [1, 3],
      [2, 4],
    ] as link}
    <path
      d={`M${nodes[link[0]].x + 110} ${nodes[link[0]].y + 23} C${nodes[link[0]].x + 140} ${nodes[link[0]].y + 23}, ${nodes[link[1]].x - 28} ${nodes[link[1]].y + 23}, ${nodes[link[1]].x - 6} ${nodes[link[1]].y + 23}`}
      stroke="#9195a1"
      strokeWidth="2"
      fill="none"
      markerEnd="url(#arrow-ui-demo)"
    />
    {/each}
    {#each nodes as item,i}
    <rect
      x={item.x}
      y={item.y}
      width="110"
      height="49"
      rx="10"
      fill={node === i ? "#343d75" : "#2a303b"}
      stroke={node === i ? "#a6b6ff" : "#747d8e"}
      strokeWidth={node === i ? 2.5 : 1}
    />
    <circle cx={item.x + 12} cy={item.y + 14} r="4" fill="#5cda9d" />
    <text
      x={item.x + 21}
      y={item.y + 18}
      fontSize="12"
      fill="#ffffff"
      fontWeight="600"
    >
      {item.label}
    </text>
    <text
      x={item.x + 12}
      y={item.y + 36}
      fontSize="10.5"
      fill="#c2c8d5"
    >
      {item.sub}
    </text>
    {/each}
    <text x="18" y="246" fill="currentColor" opacity="0.65" fontSize="11">
      Choose a service below to inspect its properties
    </text>
  </svg>
  <row wrap="wrap" gap={2}>
    {#each nodes as item,i}
    <button
      key={i}
      size="sm"
      variant={node === i ? "solid" : "outline"}
      color={node === i ? "primary" : "secondary"}
      onClick={() => setNode(i)}
    >
      {item.label}
    </button>
    {/each}
  </row>
  <box
    background="surface-secondary"
    radius="lg"
    padding={3}
    gap={2}
  >
    <row justify="between" align="center">
      **{nodes[node].label}**
      <badge color="success">Healthy</badge>
    </row>
    <grid columns={3} gap={2}>
      <grid-item>
        <caption>CPU</caption>
        <title size="lg">{[12, 38, 61, 27, 14][node]}%</title>
      </grid-item>
      <grid-item>
        <caption>Memory</caption>
        <title size="lg">{[128, 512, 768, 1024, 256][node]} MB</title>
      </grid-item>
      <grid-item>
        <caption>Replicas</caption>
        <title size="lg">{[2, 4, 3, 2, 3][node]}</title>
      </grid-item>
    </grid>
  </box>
</box>

## Personalize the interface

<box border radius="2xl" padding={4} gap={3}>
  <row align="center" justify="between">
    **UI component lab**
    <icon name="sliders-horizontal" color="secondary" />
  </row>
  <label>Accent theme</label>
  <radio-group
    direction="row"
    value={theme}
    onChange={setTheme}
  >
    <radio value="indigo">Indigo</radio>
    <radio value="green">Emerald</radio>
    <radio value="amber">Amber</radio>
  </radio-group>
  <label>Corner radius</label>
  <slider
    min={4}
    max={24}
    step={2}
    value={radius}
    onChange={setRadius}
  />
  <label>Content density</label>
  <segmented-control
    block={false}
    value={density}
    onChange={setDensity}
    options={[
      { label: "Compact", value: "compact" },
      { label: "Comfortable", value: "comfortable" },
    ]}
  />
  <divider />
  <box border radius="xl" padding={density === "compact" ? 2 : 4} gap={density === "compact" ? 2 : 4}>
    <row align="center" justify="between">
      <badge color="secondary">Live preview</badge>
      <icon name="ellipsis" color="secondary" />
    </row>
    <box gap={2}>
      <title size="lg">Welcome back, {name || "there"}</title>
      <text color="secondary" size="sm">
        Appearance and display-name changes stay in this message.
      </text>
      <input
        value={name}
        onChange={setName}
        placeholder="Enter a display name"
      />
    </box>
    <box
      radius={`${radius}px`}
      background={theme === "indigo"
        ? "#e4e9ff"
        : theme === "green"
          ? "#dcfce7"
          : "#fff0cc"}
      padding={density === "compact" ? 2 : 3}
    >
      <row align="center" gap={3}>
        <box
          radius={`${Math.max(4, radius - 4)}px`}
          background={theme === "indigo"
            ? "#5865cb"
            : theme === "green"
              ? "#25875b"
              : "#b67c1d"}
          padding={2}
        >
          <icon name="palette" color="#ffffff" />
        </box>
        <box flex="1" gap={1}>
          <text weight="medium" color="#202020">Customizable design</text>
          <text size="xs" color="#565e70">
            Radius: {radius}px · {density} layout
          </text>
        </box>
        <icon name="check-circle-2" color={theme === "indigo"
          ? "#5865cb"
          : theme === "green"
            ? "#25875b"
            : "#b67c1d"} />
      </row>
    </box>
    <button block onClick={() => setNotice(`Action triggered for ${name || "guest"}.`)}>
      <icon name="mouse-pointer-click" inline />
      Test interaction
    </button>
    {#if notice}
    <row
      background="surface-secondary"
      radius="md"
      padding={2}
      gap={2}
      align="center"
    >
      <icon name="check-circle-2" color="success" />
      <text size="sm">{notice}</text>
      <spacer />
      <button
        size="xs"
        variant="ghost"
        color="secondary"
        onClick={() => setNotice("")}
      >
        <icon name="x" />
      </button>
    </row>
    {/if}
  </box>
</box>

## Launch checklist

<box border radius="xl" padding={4} gap={3}>
  <row align="center" justify="between">
    <box gap={1}>
      **Launch checklist**
      <caption>{completed} of {tasks.length} tasks completed</caption>
    </box>
    <title size="lg">{Math.round((completed / tasks.length) * 100)}%</title>
  </row>
  <box background="surface-tertiary" height="9px" radius="full" clip>
    <box
      width={`${(completed / tasks.length) * 100}%`}
      height="100%"
      background={completed === 4 ? "#1d9a69" : "#6483db"}
      radius="full"
    />
  </box>
  {#each taskNames as task,i}
  <row
    key={i}
    align="center"
    gap={2}
    padding={{ y: 1 }}
  >
    <checkbox checked={tasks[i]} onChange={(v) => setTasks((old) => old.map((t, j) => (i === j ? v : t)))}>
      {task}
    </checkbox>
  </row>
  {/each}
  {#if completed === 4}
  <box background="surface-secondary" radius="lg" padding={3}>
    <row align="center" gap={2}>
      <icon name="check-circle-2" color="success" />
      **All launch requirements complete**
    </row>
  </box>
  {:else}
  <caption>
    {4 - completed} remaining task{4 - completed === 1 ? "" : "s"} before launch.
  </caption>
  {/if}
  <button variant="outline" color="secondary" block onClick={() => setTasks([false, false, false, false])}>
    Reset checklist
  </button>
</box>

