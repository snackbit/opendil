{
  "extends": "@opendil/tsconfig/base.json",
  "compilerOptions": {
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": ["vite/client", "node"],
    "paths": { "@/*": ["./apps/site/*"] }
  },
  "include": [
    "tests/**/*.ts",
    "tests/**/*.tsx",
    "*.config.ts",
    "packages/opendil/src/dil/isolation/globals.d.ts"
  ],
  "exclude": ["**/dist", "node_modules"]
}
