{
  "name": "opendil-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": "24.x"
  },
  "packageManager": "npm@11.17.0",
  "scripts": {
    "dev": "npm run build:package && npm run dev -w @opendil/site",
    "build:package": "npm run build -w @snackbit/opendil",
    "build": "npm run build:package && npm run build -w @opendil/site",
    "typecheck": "npm run typecheck -w @opendil/site && tsc --noEmit && npm run typecheck -w @snackbit/opendil",
    "lint": "eslint . --max-warnings=0 && node scripts/check-structure.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "check:agent-spec": "vitest run tests/unit/agent-spec.test.ts",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test:coverage",
    "check:package": "node scripts/check-package.mjs",
    "check:rebuild": "node scripts/check-rebuild.mjs",
    "check:site": "node scripts/check-site.mjs",
    "check:links": "npm run check:links -w @opendil/site",
    "check:examples": "node scripts/check-examples.mjs",
    "changeset": "changeset",
    "version:packages": "changeset version && npm install --package-lock-only --ignore-scripts --no-audit --no-fund",
    "capture:readme": "node scripts/capture-readme-demo.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.8",
    "@next/eslint-plugin-next": "16.4.5",
    "@opendil/eslint-config": "*",
    "@opendil/tsconfig": "*",
    "@playwright/test": "1.61.1",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@typescript-eslint/parser": "^8.72.1",
    "@vitest/coverage-v8": "4.1.12",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "happy-dom": "^21.0.4",
    "postcss": "^8.5.0",
    "prettier": "^3.8.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "4.1.12"
  },
  "overrides": {
    "@typescript-eslint/parser": {
      "minimatch@^10.0.0": "11.0.4"
    },
    "minimatch@^10.0.0": "11.0.4",
    "monaco-editor": {
      "dompurify": "3.4.17"
    }
  }
}
